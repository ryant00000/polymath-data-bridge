// Polymath Data Bridge configuration example.
//
// This is JSON with // comments (JSONC); trailing commas are also accepted.
// Every tile below is commented out. Uncomment at least one tile and keep at
// most four active tiles (indexes 0-3, titles and indexes unique). The Steam
// and Plex examples both use index 3, so uncomment at most one of them or
// change one to an unused index.
{
  // ------------------------------------------------------------------------
  // Data sources
  // ------------------------------------------------------------------------
  "netdata_url": "http://netdata.example.com:19999",
  "llama_url": "http://llama.example.com:10000",
  "llama_api_key": "replace-with-your-llama-api-key",
  "llama_timeout": 5.0,
  "llama_model_ttl": 0.0,
  // Only needed for an HTTPS llama.cpp server with a private CA.
  "llama_insecure": false,
  "llama_ca": null,
  "ha_url": "http://homeassistant.example.com:8123",
  "ha_token": "replace-with-a-home-assistant-long-lived-access-token",
  "ha_timeout": 5.0,
  // Only needed for an HTTPS Home Assistant with a private CA.
  "ha_insecure": false,
  "ha_ca": null,
  "steam_url": "https://api.steampowered.com",
  "steam_timeout": 5.0,
  // Only needed for an HTTPS Steam API mirror with a private CA.
  "steam_insecure": false,
  "steam_ca": null,
  "plex_url": "http://plex.example.com:32400",
  // The Plex server owner's X-Plex-Token; may also come from PLEX_TOKEN.
  "plex_token": "replace-with-your-plex-token",
  "plex_timeout": 5.0,
  // Only needed for an HTTPS Plex server with a private CA.
  "plex_insecure": false,
  "plex_ca": null,

  // ------------------------------------------------------------------------
  // Display, polling, and local files
  // ------------------------------------------------------------------------
  // Leave empty to use the hostname reported by Netdata.
  "server_name": "",
  "poll_seconds": 2.0,
  "graph_length": 120,
  // null derives "s" or "× N s" from each tile's poll_seconds.
  "time_unit": null,

  "keys_json": "~/flux/config/keys.json",
  "api_key_file": "~/.config/polymath-data-bridge/api_key",
  "state_file": "~/.local/state/polymath-data-bridge/state.json",
  // Sent to Netdata, llama.cpp, Home Assistant, Steam, Plex, and Polymath.
  "user_agent": "Polymath Data Bridge",
  "netdata_timeout": 5.0,
  "netdata_insecure": false,
  "netdata_ca": null,
  "polymath_host": "localhost",

  // ------------------------------------------------------------------------
  // Tiles
  // ------------------------------------------------------------------------
  // Optional per-tile fields, with example values:
  //   "index": 0             required, 0-3, unique
  //   "title": "EXAMPLE"     required, unique, immutable after creation
  //   "metric": "cpu"        required: cpu, ram, gpu, llama, disk, net,
  //                           temp, custom, hass, steam, or plex
  //   "chart": "system.cpu"  required for disk, temp, custom; optional for
  //                           gpu (auto-detected when omitted)
  //   "dimension": "user"    optional for gpu, temp, custom
  //   "entity": "sensor.example"  required for hass
  //   "attribute": "temperature"  optional for hass (default: entity state)
  //   "appid": 730           required for steam (the numeric Steam app id)
  //   "label": "/"           optional disk mount label
  //   "unit": "%"            optional unit override
  //   "scale": 1.0           multiply the raw value
  //   "secondary": "text"    optional lower subtext text (legacy shorthand)
  //   "eta": 100             optional for hass % tiles; lower subtext shows
  //                           time to 100% (use 0 for time to 0%)
  //   "subtexts": [ ... ]    optional 1-2 custom subtext lines (see below)
  //   "warn": 80             yellow at this value (requires crit)
  //   "crit": 95             red at this value (requires warn)
  //   "poll_seconds": 2.0    optional; inherits the global value
  //   "graph_length": 120    optional; inherits the global value
  //   "time_unit": "s"       optional; defaults from poll_seconds
  //
  // A subtext item is a string (literal text), null (keep that line's
  // default), or an object with "source":
  //   netdata: chart, optional dimension
  //   hass:    entity, optional attribute (a hass tile's own entity and
  //            attribute are used when omitted)
  //   llama:   optional field=total|pp|tg
  //   steam:   appid (defaults to the tile's appid)
  //   plex:    optional field=total|direct|transcoding|paused
  //   tile:    the tile's own plotted value
  //   text:    text
  // Every numeric source accepts label, unit, scale, decimals, and eta.
  // "subtexts" item 0 is the upper line (under the title); item 1 is the
  // lower line (under the value). eta=100 or 0 uses samples collected since
  // the bridge started and needs the source's unit to be "%". A tile-level
  // "eta" is shorthand for putting the projection on the lower line.
  //
  // One commented example per data source:
  "tiles": [
    // Netdata: a chart and dimension (CPU total here).
    // { "index": 0, "title": "CPU", "metric": "custom",
    //   "chart": "system.cpu", "dimension": "user",
    //   "unit": "%", "scale": 1.0, "secondary": "CPU user",
    //   "warn": 80, "crit": 95,
    //   "poll_seconds": 2.0, "graph_length": 120, "time_unit": "× 2 s" },

    // llama.cpp: loaded model and aggregate tokens/s.
    // { "index": 1, "title": "LLAMA", "metric": "llama" },

    // Home Assistant: an entity state, or one of its attributes.
    // Omit "attribute" to graph the entity state itself.
    // { "index": 2, "title": "ROOM", "metric": "hass",
    //   "entity": "climate.example_room", "attribute": "current_temperature",
    //   "unit": "°C", "scale": 1.0, "secondary": "Example room",
    //   "warn": 26, "crit": 30 }

    // Home Assistant percentage with an ETA and two custom subtext lines.
    // This uses index 2 too, so uncomment only one of these HA examples.
    // { "index": 2, "title": "BATTERY", "metric": "hass",
    //   "entity": "sensor.battery", "unit": "%", "eta": 100,
    //   "subtexts": [
    //     { "source": "netdata", "chart": "system.load",
    //       "dimension": "load1", "label": "load" },
    //     { "source": "hass", "entity": "sensor.battery",
    //       "label": "battery", "decimals": 1 }
    //   ],
    //   "warn": 25, "crit": 10 }

    // Steam: current players for one game, identified by its appid (730 is
    // Counter-Strike 2). Steam updates this count every few minutes, so a
    // longer poll interval than the default is usually enough.
    // { "index": 3, "title": "CS2", "metric": "steam", "appid": 730,
    //   "poll_seconds": 30.0, "graph_length": 120 }

    // Plex: active streams. The value is the session count; the secondary
    // line shows direct, transcoding, and paused counts. This and the Steam
    // example both use index 3, so uncomment at most one or change its index.
    // { "index": 3, "title": "PLEX", "metric": "plex",
    //   "poll_seconds": 10.0, "graph_length": 120 }
  ]
}
