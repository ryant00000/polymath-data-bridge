[Unit]
Description=Flux Netdata Bridge (Netdata -> Polymath graph tiles)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/flux-netdata-bridge --config %h/.config/flux-netdata-bridge/config.json
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
