[Unit]
Description=Polymath Data Bridge (metrics -> Polymath graph tiles)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/polymath-data-bridge --config %h/.config/polymath-data-bridge/config.json
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
